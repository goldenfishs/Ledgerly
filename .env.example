# Docker Compose: copy this file to .env and customize as needed.
# Keep the default loopback binding when placing a reverse proxy on this host.
LEDGERLY_BIND_HOST=127.0.0.1
LEDGERLY_PORT=10670
LEDGERLY_IMAGE=ghcr.io/goldenfishs/ledgerly
LEDGERLY_IMAGE_TAG=latest

# HTTPS reverse proxy example: https://ledger.example.com (no path).
# Leave empty for direct local access. Enable secure cookies only with HTTPS.
STUDIO_PUBLIC_ORIGIN=
STUDIO_COOKIE_SECURE=false

# Optional invoice OCR via an OpenAI-compatible vision endpoint.
# Leave all three empty to use manual invoice entry without an external service.
# Example base URL: https://api.example.com/v1
STUDIO_LLM_BASE_URL=
STUDIO_LLM_MODEL=
STUDIO_LLM_API_KEY=

# SMTP and registration policy are configured in the administrator settings UI.
# SMTP secrets are encrypted inside /app/data; include system.key in backups.

# Optional build overrides for compatible base images or local mirrors.
# NODE_BASE_IMAGE=node:22-alpine
# PYTHON_BASE_IMAGE=python:3.12-slim

# Local development uses http://127.0.0.1:8000 for the API by default.
# To change the Vite proxy, export this in the shell running npm, for example:
# LEDGERLY_API_PROXY=http://127.0.0.1:8001 npm run dev --prefix frontend
# Compose's .env is not automatically loaded by the local Vite process.
